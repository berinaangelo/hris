<% content_for :title, "Company Reviews" %>

<div class="company-review-cycles" data-controller="view-toggle">
<div class="toolbar bulma-is-flex bulma-is-flex-direction-row bulma-is-align-items-start">
  <div class="bulma-is-flex bulma-is-flex-direction-row bulma-is-align-items-start">
    <div class="field">
      <%= form_with url: company_review_cycles_path, method: :get, local: true do %>
        <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search by name">
      <% end %>
    </div>

    <div class="chip-row pl-3">
      <%= link_to "All", company_review_cycles_path(q: params[:q], show_offboarded: params[:show_offboarded]),
            class: "chip-filter #{"is-active" unless params[:department].present?}" %>
      <% @departments.each do |department| %>
        <%= link_to department, company_review_cycles_path(department: department, q: params[:q], show_offboarded: params[:show_offboarded]),
              class: "chip-filter #{"is-active" if params[:department] == department}" %>
      <% end %>
    </div>
  </div>

  <div class="bulma-is-flex-grow-1 bulma-is-flex bulma-is-justify-content-flex-end bulma-is-align-items-center bulma-is-gap-1">
    <button type="button" data-action="btn view-toggle#showList" class="view-toggle-btn is-bordered is-active" data-view-toggle-target="listBtn"><%= lucide_icon(:list) %></button>
    <button type="button" data-action="btn view-toggle#showCards" class="view-toggle-btn is-bordered" data-view-toggle-target="cardsBtn"><%= lucide_icon(:grid) %></button>
  </div>
</div>

<div data-controller="modal">
  <div class="card">
    <table data-view-toggle-target="list">
      <thead><tr><th>Employee</th><th>Department</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% @employees.each do |employee| %>
          <% presenter = ReviewStatusPresenter.new(employee) %>
          <tr>
            <td><%= employee.full_name %></td>
            <td><%= employee.department %></td>
            <td>
              <% if (category = presenter.badge_category(scope: :company)) %>
                <span class="badge badge-<%= category %>"><%= presenter.label %></span>
              <% else %>
                <%= presenter.label %>
              <% end %>
            </td>
            <td>
              <%= link_to "View", company_review_cycle_path(employee), class: "btn btn-ghost",
                           data: { action: "modal#open", turbo_frame: "company_review_modal" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="review-cycles-card-grid" data-view-toggle-target="cards" hidden>
      <% @employees.each do |employee| %>
        <% presenter = ReviewStatusPresenter.new(employee) %>
        <%= link_to company_review_cycle_path(employee), class: "card",
                     data: { action: "modal#open", turbo_frame: "company_review_modal" } do %>
          <strong><%= employee.full_name %></strong><br>
          <span><%= employee.department %></span><br>
          <% if (category = presenter.badge_category(scope: :company)) %>
            <span class="badge badge-<%= category %>"><%= presenter.label %></span>
          <% else %>
            <span><%= presenter.label %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <p>
      Showing 1–<%= @employees.size %> of <%= @employees.size %>
      <button type="button" class="btn btn-ghost" disabled>Prev</button>
      <button type="button" class="btn btn-ghost" disabled>Next</button>
    </p>
  </div>

  <%= render "shared/modal", frame_id: "company_review_modal" %>
</div>

<%= link_to "Start new cycle", new_company_review_cycle_path, class: "btn btn-primary" %>
</div>