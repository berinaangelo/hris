<h1>Change access level</h1>

<div class="card">
  <p><strong><%= @employee.full_name %></strong> · <%= @employee.job_title %></p>

  <%= form_with model: @employee, url: roles_access_path(@employee), method: :patch, local: true do |f| %>
    <div class="field">
      <label>
        <%= f.radio_button :role, "employee", checked: @employee.employee? %> Employee
      </label>
      <p><small>Everyone's default. Self-service only — own profile, own leave requests, own payslips and reviews.</small></p>
    </div>
    <div class="field">
      <label>
        <%= f.radio_button :role, "manager", checked: @employee.manager? %> Manager
      </label>
      <p><small>Everything Employee has, plus the Team tab — approving their own direct reports and reviewing their team.</small></p>
    </div>
    <div class="field">
      <label>
        <%= f.radio_button :role, "admin", checked: @employee.admin? %> Admin
      </label>
      <p><small>Full access, including the Company tab — People Directory, Payroll, Recruitment, Compliance, Reports, and this screen.</small></p>
    </div>
    <%= f.submit "Save access level", class: "btn btn-primary" %>
    <%= link_to "Cancel", roles_access_index_path, class: "btn btn-ghost" %>
  <% end %>
</div>
