<div class="field">
  <%= f.label :title %>
  <%= f.text_field :title, required: true %>
</div>
<div class="field">
  <%= f.label :description %>
  <%= f.text_area :description %>
</div>
<div class="field">
  <%= f.label :status %>
  <%= f.select :status, JobOpening.statuses.keys.map { |s| [ s.humanize, s ] } %>
</div>
