<h1>Edit job opening</h1>

<div class="card">
  <%= form_with model: @job_opening, url: job_opening_path(@job_opening), method: :patch, local: true do |f| %>
    <%= render "form", f: f %>
    <%= f.submit "Save", class: "btn btn-primary" %>
  <% end %>
</div>

<div class="card">
  <p>Apply link: <code><%= careers_url(@job_opening.slug) %></code></p>
</div>
