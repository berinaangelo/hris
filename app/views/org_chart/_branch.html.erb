<div style="margin-left: <%= depth * 2 %>rem; padding: 0.5rem 0;">
  <span class="badge badge-neutral"><%= employee.full_name %> · <%= employee.job_title %></span>
</div>
<% (reports_by_manager_id[employee.id] || []).each do |report| %>
  <%= render partial: "branch", locals: { employee: report, reports_by_manager_id: reports_by_manager_id, depth: depth + 1 } %>
<% end %>
