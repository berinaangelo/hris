<h1>Request an attendance correction</h1>

<div class="card">
  <%= form_with url: attendance_correction_requests_path, scope: :attendance_correction_request do |f| %>
    <div class="field">
      <%= f.label :date %>
      <%= f.date_field :date, required: true %>
    </div>
    <div class="field">
      <%= f.label :requested_clock_in_at, "Corrected clock in (optional)" %>
      <%= f.datetime_field :requested_clock_in_at %>
    </div>
    <div class="field">
      <%= f.label :requested_clock_out_at, "Corrected clock out (optional)" %>
      <%= f.datetime_field :requested_clock_out_at %>
    </div>
    <div class="field">
      <%= f.label :reason %>
      <%= f.text_area :reason, required: true %>
    </div>
    <p>Goes to <%= current_employee.manager&.full_name || "an admin" %> for approval.</p>
    <%= f.submit "Submit request", class: "btn btn-primary" %>
  <% end %>
</div>
