<h1>Edit certification</h1>

<div class="card">
  <p><strong><%= @certification.employee.full_name %></strong> · <%= @certification.cert_name %></p>

  <%= form_with model: @certification, url: certification_path(@certification), local: true do |f| %>
    <%= render "form", f: f %>
    <%= f.submit "Save changes", class: "btn btn-primary" %>
    <%= link_to "Cancel", certifications_path, class: "btn btn-ghost" %>
  <% end %>
</div>

<div class="card">
  <%= button_to "Delete certification", certification_path(@certification), method: :delete, class: "btn btn-danger-outline" %>
</div>
