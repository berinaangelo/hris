<div class="field">
  <%= f.label :employee_id, "Employee" %>
  <%= f.select :employee_id, @employees.map { |employee| [ employee.full_name, employee.id ] }, include_blank: "Select an employee" %>
</div>
<div class="field">
  <%= f.label :cert_name, "Certification name" %>
  <%= f.text_field :cert_name, required: true %>
</div>
<div class="field">
  <%= f.label :expiry_date %>
  <%= f.date_field :expiry_date, required: true %>
</div>
