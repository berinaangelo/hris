<% content_for :title, "My Payslips" %>

<div class="payslips-page">
  <h2 class="mb-3">My Payslips</h2>

  <% if @payslips.none? %>
    <div class="empty-state">
      <%= lucide_icon(:banknote, class: "icon") %>
      <h3>No payslips yet</h3>
      <p>Your first payslip will show up here once payroll finalizes a cutoff you're included in.</p>
    </div>
  <% else %>
    <div class="op2-body">
      <%= turbo_frame_tag "payslip_breakdown" do %>
        <%= render "breakdown", payslip: @pinned_payslip %>
      <% end %>

      <div>
        <div class="list-head"><h3>All payslips</h3></div>
        <div class="table-wrap">
          <table class="paytable">
            <thead><tr><th>Cutoff</th><th>Pay date</th><th>Type</th><th>Gross</th><th>Net</th></tr></thead>
            <tbody>
              <% @payslips.each do |payslip| %>
                <% presenter = PayslipPresenter.new(payslip) %>
                <tr class="view-row<%= " is-pinned" if payslip == @pinned_payslip %>">
                  <td><%= link_to presenter.period_label, payslips_path(pinned_id: payslip.id), data: { turbo_frame: "payslip_breakdown" } %></td>
                  <td class="mono"><%= payslip.payroll_run.pay_date.strftime("%b %-d, %Y") %></td>
                  <td><% if presenter.thirteenth_month? %><span class="badge badge-neutral">13th Month</span><% end %></td>
                  <td class="mono"><%= number_to_currency(payslip.gross_pay, unit: "₱") %></td>
                  <td class="mono net"><%= number_to_currency(payslip.net_pay, unit: "₱") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
