<% admin_viewing = current_employee.admin? %>
<% content_for :title, "Payslip" %>

<%# Breakdown + audit rail — see
    kos/decisions/ui/payslip-detail-admin-breakdown-audit-rail.md and
    kos/decisions/ux-pages/payslip-detail-admin.html ("Breakdown + audit
    rail", chosen). Scoped to an already-finalized payslip, same as the
    mockup itself — the admin-viewing-a-draft branch below keeps its
    plain scaffold (light baseline styling only), since draft line-item
    editing now lives on Payroll Run Detail's edit drawer. %>
<div class="payslip-detail-page">
  <% if admin_viewing %>
    <p class="crumb"><%= link_to "Payroll", payroll_runs_path %> → <%= link_to "#{@payslip.payroll_run.period_start} – #{@payslip.payroll_run.period_end}", payroll_run_path(@payslip.payroll_run) %> → <b><%= @payslip.employee.full_name %></b></p>
  <% end %>

  <div class="pd-head">
    <% if admin_viewing %>
      <span class="avatar"><%= @payslip.employee.first_name.first %><%= @payslip.employee.last_name.first %></span>
    <% end %>
    <div class="pd-who">
      <% if admin_viewing %>
        <p class="pd-name"><%= @payslip.employee.full_name %> <span class="muted">(<%= @payslip.employee.employee_number %>)</span></p>
      <% end %>
      <div class="pd-title">
        <h2><%= @payslip.payroll_run.period_start %> – <%= @payslip.payroll_run.period_end %></h2>
        <% badge = BadgePresenter.new(@payslip.status) %><span class="<%= badge.css_class %>"><%= badge.label %></span>
      </div>
      <p class="pd-sub">Pay date <%= @payslip.payroll_run.pay_date %></p>
    </div>
  </div>

  <% if admin_viewing && @payslip.draft? %>
    <div class="card">
      <h2>Line items</h2>
      <table>
        <thead><tr><th>Type</th><th>Direction</th><th>Description</th><th>Amount</th><th></th></tr></thead>
        <tbody>
          <% @payslip.payslip_line_items.each do |item| %>
            <tr>
              <%= form_with model: item, url: payslip_line_item_path(@payslip, item), method: :patch, local: true do |f| %>
                <td><%= f.select :line_type, PayslipLineItem.line_types.keys.map { |t| [ t.humanize, t ] }, {}, class: "plain-select" %></td>
                <td><%= f.select :direction, PayslipLineItem.directions.keys.map { |d| [ d.humanize, d ] }, {}, class: "plain-select" %></td>
                <td><%= f.text_field :description, class: "plain-input" %></td>
                <td><%= f.number_field :amount, step: 0.01, min: 0.01, class: "plain-input" %></td>
                <td>
                  <%= f.submit "Save", class: "btn-ghost btn-sm" %>
                  <%= button_to "Remove", payslip_line_item_path(@payslip, item), method: :delete, class: "btn-ghost danger btn-sm", form: { style: "display:inline" } %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>

      <h3>Add a line item</h3>
      <%= form_with model: PayslipLineItem.new, url: payslip_line_items_path(@payslip), method: :post, local: true do |f| %>
        <div class="field">
          <%= f.label :line_type %>
          <%= f.select :line_type, PayslipLineItem.line_types.keys.map { |t| [ t.humanize, t ] }, {}, class: "plain-select" %>
        </div>
        <div class="field">
          <%= f.label :direction %>
          <%= f.select :direction, PayslipLineItem.directions.keys.map { |d| [ d.humanize, d ] }, {}, class: "plain-select" %>
        </div>
        <div class="field">
          <%= f.label :description %>
          <%= f.text_field :description, class: "plain-input" %>
        </div>
        <div class="field">
          <%= f.label :amount %>
          <%= f.number_field :amount, step: 0.01, min: 0.01, required: true, class: "plain-input" %>
        </div>
        <%= f.submit "Add line item", class: "btn-ghost" %>
      <% end %>
    </div>
  <% elsif admin_viewing %>
    <div class="op2-layout">
      <div class="op2-main">
        <%= render "breakdown", payslip: @payslip %>
      </div>

      <aside class="rail">
        <div class="rail-card">
          <p class="card-label">Record</p>
          <div class="rail-row"><span>Run</span><%= link_to "#{@payslip.payroll_run.period_start} – #{@payslip.payroll_run.period_end}", payroll_run_path(@payslip.payroll_run) %></div>
          <div class="rail-row"><span>Generated</span><span><%= @payslip.generated_at ? @payslip.generated_at.strftime("%b %-d, %Y %-I:%M %p") : "Not yet generated" %></span></div>
          <div class="rail-row"><span>Generated by</span><span><%= @payslip.generated_by&.full_name || "—" %></span></div>
        </div>

        <div class="rail-card">
          <p class="card-label">Delivery</p>
          <div class="rail-row"><span>Emailed</span><span><%= @payslip.emailed_at ? @payslip.emailed_at.strftime("%b %-d, %Y %-I:%M %p") : "Not sent" %></span></div>
          <div class="rail-row">
            <span>Viewed</span>
            <% if @payslip.viewed_at %>
              <span class="badge badge-positive">Yes</span>
            <% else %>
              <span class="muted">Not yet viewed</span>
            <% end %>
          </div>
        </div>

        <div class="rail-card">
          <p class="card-label">Correction history</p>
          <% chain = PayslipPresenter.new(@payslip).version_chain %>
          <div class="timeline">
            <% chain.each_with_index do |version, index| %>
              <% is_current = version == chain.last %>
              <div class="tl-item <%= "is-current" if is_current %>">
                <span class="tl-dot"></span>
                <div class="tl-content">
                  <div class="tl-head">
                    <%= link_to "v#{index + 1}", payslip_path(version) %>
                    <% if is_current %>
                      <span class="badge badge-positive">Current</span>
                    <% else %>
                      <% version_badge = BadgePresenter.new(version.status) %>
                      <span class="<%= version_badge.css_class %>"><%= version_badge.label %></span>
                    <% end %>
                  </div>
                  <p class="tl-meta">
                    <%= version.updated_at.to_date.strftime("%b %-d, %Y") %>
                    <% if version.voided? && version.void_reason.present? %> · &ldquo;<%= version.void_reason %>&rdquo;<% end %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="rail-card rail-actions">
          <p class="card-label">Actions</p>
          <button type="button" class="btn-ghost" disabled title="Coming soon"><%= lucide_icon(:download) %>Download</button>
          <button type="button" class="btn-ghost" disabled title="Coming soon"><%= lucide_icon(:mail) %>Resend email</button>
          <% if @payslip.finalized? %>
            <%# Not shared/_modal.html.erb — that partial is wired for
                async turbo-frame content; this form is already inline
                on the page, so it reuses the same dialog/app-modal
                chrome + modal_controller.js directly instead. %>
            <span data-controller="modal">
              <button type="button" class="btn-ghost danger" data-action="modal#open"><%= lucide_icon(:"upload-cloud") %>Void &amp; reissue</button>
              <dialog data-modal-target="dialog" data-action="click->modal#closeOnBackdrop" class="app-modal">
                <div class="app-modal-content">
                  <button type="button" class="app-modal-close btn-ghost" data-action="modal#close">Close</button>
                  <h3>Void &amp; reissue this payslip?</h3>
                  <p class="muted">Marks this version Voided and creates a new draft you can correct. The employee isn't notified until the reissue is itself finalized.</p>
                  <%= form_with url: void_and_reissue_payslip_path(@payslip), method: :patch, local: true do %>
                    <div class="modal-field">
                      <%= label_tag :void_reason, "Reason for correction" %>
                      <%= text_area_tag :void_reason, nil, required: true, class: "plain-input",
                            placeholder: "e.g. Overtime hours were entered incorrectly for this cutoff" %>
                    </div>
                    <div class="modal-actions">
                      <button type="button" class="btn-ghost" data-action="modal#close">Cancel</button>
                      <button type="submit" class="btn-primary">Void &amp; create reissue</button>
                    </div>
                  <% end %>
                </div>
              </dialog>
            </span>
          <% elsif @payslip.draft? %>
            <%= button_to "Finalize this payslip", finalize_payslip_path(@payslip), method: :patch, class: "btn-primary",
                  data: { turbo_confirm: "Finalize this payslip? Its line items will be locked." } %>
          <% end %>
        </div>
      </aside>
    </div>
  <% else %>
    <div class="card payslips-page">
      <%= render "breakdown", payslip: @payslip %>
    </div>
  <% end %>
</div>
