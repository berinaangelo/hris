<% admin_viewing = current_employee.admin? %>

<h1>
  Payslip — <%= @payslip.payroll_run.period_start %> to <%= @payslip.payroll_run.period_end %>
  <% badge = BadgePresenter.new(@payslip.status) %><span class="<%= badge.css_class %>"><%= badge.label %></span>
</h1>
<p>
  Pay date <%= @payslip.payroll_run.pay_date %>
  <% if admin_viewing %>
    · <%= @payslip.employee.full_name %> (<%= @payslip.employee.employee_number %>)
  <% end %>
</p>

<% if admin_viewing && @payslip.draft? %>
  <div class="card">
    <h2>Line items</h2>
    <table>
      <thead><tr><th>Type</th><th>Direction</th><th>Description</th><th>Amount</th><th></th></tr></thead>
      <tbody>
        <% @payslip.payslip_line_items.each do |item| %>
          <tr>
            <%= form_with model: item, url: payslip_line_item_path(@payslip, item), method: :patch, local: true do |f| %>
              <td><%= f.select :line_type, PayslipLineItem.line_types.keys.map { |t| [ t.humanize, t ] } %></td>
              <td><%= f.select :direction, PayslipLineItem.directions.keys.map { |d| [ d.humanize, d ] } %></td>
              <td><%= f.text_field :description %></td>
              <td><%= f.number_field :amount, step: 0.01, min: 0.01 %></td>
              <td>
                <%= f.submit "Save", class: "btn btn-ghost" %>
                <%= button_to "Remove", payslip_line_item_path(@payslip, item), method: :delete, class: "btn btn-danger-outline", form: { style: "display:inline" } %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h3>Add a line item</h3>
    <%= form_with model: PayslipLineItem.new, url: payslip_line_items_path(@payslip), method: :post, local: true do |f| %>
      <div class="field">
        <%= f.label :line_type %>
        <%= f.select :line_type, PayslipLineItem.line_types.keys.map { |t| [ t.humanize, t ] } %>
      </div>
      <div class="field">
        <%= f.label :direction %>
        <%= f.select :direction, PayslipLineItem.directions.keys.map { |d| [ d.humanize, d ] } %>
      </div>
      <div class="field">
        <%= f.label :description %>
        <%= f.text_field :description %>
      </div>
      <div class="field">
        <%= f.label :amount %>
        <%= f.number_field :amount, step: 0.01, min: 0.01, required: true %>
      </div>
      <%= f.submit "Add line item", class: "btn btn-ghost" %>
    <% end %>
  </div>
<% else %>
  <div class="card payslips-page">
    <%= render "breakdown", payslip: @payslip %>
  </div>
<% end %>

<div class="card">
  <p>Gross pay: ₱<%= @payslip.gross_pay %></p>
  <p>Total deductions: ₱<%= @payslip.total_deductions %></p>
  <p><strong>Net pay: ₱<%= @payslip.net_pay %></strong></p>
</div>

<% if admin_viewing %>
  <div class="card">
    <h2>Record</h2>
    <p>Run: <%= link_to "#{@payslip.payroll_run.period_start} – #{@payslip.payroll_run.period_end}", payroll_run_path(@payslip.payroll_run) %></p>
    <p>Generated: <%= @payslip.generated_at ? @payslip.generated_at.strftime("%b %-d, %Y %-I:%M %p") : "Not yet generated" %></p>
    <p>Generated by: <%= @payslip.generated_by&.full_name || "—" %></p>
  </div>

  <div class="card">
    <h2>Delivery</h2>
    <p>Emailed: <%= @payslip.emailed_at ? @payslip.emailed_at.strftime("%b %-d, %Y %-I:%M %p") : "Not sent" %></p>
    <p>Viewed by employee: <%= @payslip.viewed_at ? "Yes, #{@payslip.viewed_at.strftime('%b %-d, %Y %-I:%M %p')}" : "Not yet viewed" %></p>
  </div>

  <div class="card">
    <h2>Correction history</h2>
    <% PayslipPresenter.new(@payslip).version_chain.each do |version| %>
      <p>
        <% version_badge = BadgePresenter.new(version.status) %><span class="<%= version_badge.css_class %>"><%= version_badge.label %></span>
        <%= link_to "View", payslip_path(version) %>
        <% if version == @payslip %> (this version) <% end %>
        <% if version.voided? %><br><small><%= version.void_reason %></small><% end %>
      </p>
    <% end %>
  </div>

  <div class="card">
    <h2>Actions</h2>
    <% if @payslip.finalized? %>
      <%= form_with url: void_and_reissue_payslip_path(@payslip), method: :patch, local: true do %>
        <div class="field">
          <label for="void_reason">Reason for correction</label>
          <textarea name="void_reason" id="void_reason" required placeholder="e.g. Overtime hours were entered incorrectly for this cutoff"></textarea>
        </div>
        <button type="submit" class="btn btn-danger-outline" data-turbo-confirm="Void this payslip and create a new draft you can correct? The employee is not notified until the reissue is itself finalized.">Void &amp; reissue</button>
      <% end %>
    <% elsif @payslip.draft? %>
      <%= button_to "Finalize this payslip", finalize_payslip_path(@payslip), method: :patch, class: "btn btn-primary",
            data: { turbo_confirm: "Finalize this payslip? Its line items will be locked." } %>
    <% end %>
  </div>
<% end %>
