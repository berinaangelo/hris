<div class="card">
  <h3>Add a benefit plan</h3>
  <%= form_with url: employee_benefit_enrollments_path(employee), local: true do %>
    <div class="field">
      <label>Plan name</label>
      <%= text_field_tag "benefit_enrollment[plan_name]" %>
    </div>
    <div class="field">
      <label>Provider</label>
      <%= text_field_tag "benefit_enrollment[provider]" %>
    </div>
    <div class="field">
      <label>Effectivity date</label>
      <%= date_field_tag "benefit_enrollment[effectivity_date]" %>
    </div>
    <%= submit_tag "Add plan", class: "btn btn-ghost" %>
  <% end %>
</div>
