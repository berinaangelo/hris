<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hris" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hris">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if current_employee %>
      <nav class="app-nav">
        <span class="brand">HRIS</span>
        <%= link_to "Home", root_path %>
        <%= link_to "Time Off", leave_requests_path %>
        <%= link_to "Attendance", attendance_correction_requests_path %>
        <%= link_to "My Profile", my_profile_path %>
        <% if current_employee.manager? || current_employee.admin? %>
          <%= link_to team_approvals_path do %>
            Approvals
            <% if (count = LeaveRequests::PendingForApprover.call(current_employee).count) > 0 %>
              <span class="badge badge-caution"><%= count %></span>
            <% end %>
          <% end %>
          <%= link_to team_attendance_correction_requests_path do %>
            Attendance Corrections
            <% if (count = AttendanceCorrectionRequests::PendingForApprover.call(current_employee).count) > 0 %>
              <span class="badge badge-caution"><%= count %></span>
            <% end %>
          <% end %>
        <% end %>
        <% if current_employee.admin? %>
          <%= link_to team_attendance_edit_approvals_path do %>
            Attendance Sign-offs
            <% if (count = AttendanceRecords::PendingApproverSignoff.call(current_employee).count) > 0 %>
              <span class="badge badge-caution"><%= count %></span>
            <% end %>
          <% end %>
          <%= link_to "People", employees_path %>
          <%= link_to "Org Chart", org_chart_path %>
          <%= link_to "Compliance", certifications_path %>
          <%= link_to "Roles & Access", roles_access_index_path %>
        <% end %>
        <span class="nav-spacer"></span>
        <%= link_to "Account Settings", account_settings_path %>
        <span class="nav-user"><%= current_employee.full_name %></span>
        <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
      </nav>
    <% end %>

    <% if notice %><p class="flash flash-notice"><%= notice %></p><% end %>
    <% if alert %><p class="flash flash-alert"><%= alert %></p><% end %>

    <main class="app-main">
      <%= yield %>
    </main>
  </body>
</html>
