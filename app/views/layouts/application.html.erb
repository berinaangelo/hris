<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hris" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hris">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Archivo/Work Sans/IBM Plex Mono — see kos/decisions/ui/type-system-neutral-and-efficient.md.
        Declared in application.scss's font stacks already; this is what actually loads them. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if current_employee %>
      <% nav = NavigationPresenter.new(current_employee: current_employee, request_controller_path: params[:controller],
                                        section_override: @nav_section_override) %>
      <%= render "layouts/app_nav", nav: nav %>
    <% end %>

    <% if notice %><p class="flash flash-notice"><%= notice %></p><% end %>
    <% if alert %><p class="flash flash-alert"><%= alert %></p><% end %>

    <% if current_employee && nav.current_section %>
      <div class="app-body">
        <%= render "layouts/side_nav", nav: nav %>
        <main class="app-main">
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="app-main">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
