<% content_for :title, "Payroll Run" %>

<%# Master table + per-row edit drawer — see
    kos/decisions/ui/payroll-run-detail-master-table-edit-drawer.md and
    kos/decisions/ux-pages/payroll-run-detail.html ("Master table + edit
    drawer", chosen). Missing-OT tracking/blocking is deliberately not
    built — see the plan's Context section. %>
<div class="payroll-run-detail-page">
  <%= link_to payroll_runs_path, class: "back-link" do %>
    <%= lucide_icon(:"chevron-left") %>Back to Payroll
  <% end %>

  <div class="run-detail-head">
    <div>
      <div class="run-detail-title">
        <h2><%= @payroll_run.period_start.strftime("%b %-d") %>–<%= @payroll_run.period_end.strftime("%-d, %Y") %></h2>
        <% status_badge = BadgePresenter.new(@payroll_run.status) %>
        <span class="<%= status_badge.css_class %>"><%= status_badge.label %></span>
      </div>
      <p class="run-detail-sub">
        Pay date <%= @payroll_run.pay_date.strftime("%b %-d, %Y") %> · <%= @stats[:employees] %> employees
        <% if @payroll_run.finalized? %>
          · finalized by <%= @payroll_run.finalized_by&.full_name %> on <%= @payroll_run.finalized_at&.to_date&.strftime("%b %-d, %Y") %>
        <% end %>
      </p>
    </div>
    <div class="run-detail-actions">
      <%= link_to payroll_run_path(@payroll_run, format: :csv), class: "btn-ghost" do %>
        <%= lucide_icon(:download) %>Export
      <% end %>
      <% if @payroll_run.open? %>
        <%= button_to "Finalize payroll run", finalize_payroll_run_path(@payroll_run), method: :patch, class: "btn-primary",
              data: { turbo_confirm: "Finalize this run? This locks every payslip and decrements loan installments." } %>
      <% end %>
    </div>
  </div>

  <div class="stat-strip">
    <div class="stat-tile"><span class="num"><%= @stats[:employees] %></span><span class="lbl">Employees</span></div>
    <div class="stat-tile"><span class="num"><%= number_to_currency(@payroll_run.payslips.sum(:gross_pay), unit: "₱") %></span><span class="lbl">Gross so far</span></div>
    <div class="stat-tile"><span class="num"><%= @stats[:loan_deductions] %></span><span class="lbl">Loan deductions auto-added</span></div>
  </div>

  <div class="table-wrap">
    <table class="cptable">
      <thead>
        <tr>
          <th>Employee</th><th class="num-col">Base salary</th><th class="num-col">Adjustments</th>
          <th class="num-col">Loan</th><th class="num-col">Statutory</th><th class="num-col">Net pay</th><th>Status</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% @payroll_run.payslips.each do |payslip| %>
          <% presenter = PayslipPresenter.new(payslip) %>
          <tr>
            <td class="emp-cell">
              <span class="avatar"><%= payslip.employee.first_name.first %><%= payslip.employee.last_name.first %></span>
              <div>
                <h4><%= link_to payslip.employee.full_name, payslip_path(payslip) %></h4>
                <p><%= payslip.employee.job_title %> · <%= payslip.employee.department %></p>
              </div>
            </td>
            <td class="num-col mono"><%= number_to_currency(presenter.base_salary, unit: "₱") %></td>
            <td class="num-col mono"><%= number_to_currency(presenter.adjustments_total, unit: "₱") %></td>
            <td class="num-col mono"><%= number_to_currency(presenter.loan_deductions, unit: "₱") %></td>
            <td class="num-col mono"><%= number_to_currency(presenter.statutory_deductions, unit: "₱") %></td>
            <td class="num-col mono"><%= number_to_currency(payslip.net_pay, unit: "₱") %></td>
            <td>
              <% if payslip.voided? %>
                <% payslip_badge = BadgePresenter.new(payslip.status) %>
                <span class="<%= payslip_badge.css_class %>"><%= payslip_badge.label %></span>
              <% end %>
            </td>
            <td>
              <% if policy(payslip).edit_line_items? %>
                <span data-controller="modal">
                  <button type="button" class="icon-btn" data-action="modal#open" title="Edit"><%= lucide_icon(:pencil) %></button>
                  <%= render "shared/drawer", title: payslip.employee.full_name do %>
                    <%= render "payslip_adjustments", payslip: payslip %>
                  <% end %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
