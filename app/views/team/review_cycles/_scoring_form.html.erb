<div class="inprogress-note">
  <%= lucide_icon(:clock, stroke_width: 1.75) %>
  <%= cycle.end_date.to_fs(:long) %> ended — fill in actuals and scores to publish.
</div>

<%= form_with url: publish_team_review_cycle_path(cycle), method: :patch, local: true do %>
  <div class="table-wrap">
    <table class="kpitable">
      <thead>
        <tr><th>KPI</th><th>Target</th><th>Actual</th><th>Score</th></tr>
      </thead>
      <tbody>
        <% cycle.kpi_entries.each do |kpi_entry| %>
          <tr>
            <td><p class="name"><%= kpi_entry.kpi_name %></p></td>
            <td class="muted"><%= kpi_entry.target %></td>
            <td><%= text_field_tag "kpi_entries[#{kpi_entry.id}][actual]", kpi_entry.actual, class: "plain-input compact" %></td>
            <td>
              <div class="score-edit-cell" data-controller="score-select">
                <%= select_tag "kpi_entries[#{kpi_entry.id}][score]", options_for_select((1..5).to_a, kpi_entry.score),
                                include_blank: true, class: "plain-input compact narrow",
                                data: { "score-select-target": "select", action: "change->score-select#sync" } %>
                <div class="score-track"><div class="score-fill" data-score-select-target="fill" style="width:<%= (kpi_entry.score || 0) * 20 %>%"></div></div>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="tt-drawer-field">
    <%= label_tag :manager_comment, "Overall comment" %>
    <%= text_area_tag :manager_comment, cycle.manager_comment, class: "plain-input" %>
  </div>

  <% if cycle.pip? %>
    <div class="tt-drawer-field">
      <%= label_tag :outcome, "Outcome" %>
      <%= select_tag :outcome,
                      options_for_select([ [ "Passed", "passed" ], [ "Not passed", "not_passed" ], [ "Extended", "extended" ] ], cycle.outcome),
                      include_blank: "Select an outcome", class: "plain-input" %>
    </div>
  <% end %>

  <div class="form-actions">
    <button type="submit" formaction="<%= save_draft_team_review_cycle_path(cycle) %>" class="btn-ghost">Save draft</button>
    <button type="submit" class="btn-primary">Publish review</button>
  </div>
<% end %>
