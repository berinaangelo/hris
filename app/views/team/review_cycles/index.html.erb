<% content_for :title, "Team Reviews" %>

<div class="team-reviews-page">
  <h1>Team Reviews</h1>

  <%= turbo_frame_tag "team_review_detail", class: "card review-cycles-layout" do %>
    <div class="review-cycles-rail">
      <% if @direct_reports.empty? %>
        <p class="muted">No direct reports.</p>
      <% end %>
      <% @direct_reports.each do |employee| %>
        <% presenter = ReviewStatusPresenter.new(employee) %>
        <%= link_to team_review_cycles_path(employee_id: employee.id),
                     class: "review-cycle-row#{" is-selected" if @selected_employee == employee}" do %>
          <span class="avatar"><%= employee.first_name.first %><%= employee.last_name.first %></span>
          <span class="meta-col">
            <span class="name"><%= employee.full_name %></span>
            <span class="meta">
              <% if (category = presenter.badge_category(scope: :team)) %>
                <span class="badge badge-<%= category %>"><%= presenter.label %></span>
              <% else %>
                <span class="mono"><%= presenter.label %></span>
              <% end %>
            </span>
          </span>
        <% end %>
      <% end %>
    </div>

    <div class="review-cycle-detail">
      <%= render "detail", employee: @selected_employee %>
    </div>
  <% end %>
</div>
