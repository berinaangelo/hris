<h1>Edit attendance</h1>

<div class="card">
  <p><strong><%= @attendance_record.employee.full_name %></strong> · <%= @attendance_record.date %></p>

  <%= form_with model: @attendance_record, url: team_attendance_record_path(@attendance_record), method: :patch, local: true do |f| %>
    <div class="field">
      <%= f.label :clock_in_at %>
      <%= f.datetime_field :clock_in_at %>
    </div>
    <div class="field">
      <%= f.label :clock_out_at %>
      <%= f.datetime_field :clock_out_at %>
    </div>
    <%= f.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", team_attendance_records_path, class: "btn btn-ghost" %>
  <% end %>
</div>
