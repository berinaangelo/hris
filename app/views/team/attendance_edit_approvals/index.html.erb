<h1>Attendance edit sign-offs</h1>

<div class="card">
  <% if @pending.any? %>
    <table>
      <thead><tr><th>Employee</th><th>Date</th><th>Clock in</th><th>Clock out</th><th>Edited by</th><th></th></tr></thead>
      <tbody>
        <% @pending.each do |record| %>
          <tr>
            <td><%= record.employee.full_name %></td>
            <td><%= record.date %></td>
            <td><%= record.clock_in_at&.in_time_zone(current_employee.company.timezone)&.strftime("%l:%M %p") || "—" %></td>
            <td><%= record.clock_out_at&.in_time_zone(current_employee.company.timezone)&.strftime("%l:%M %p") || "—" %></td>
            <td><%= record.edited_by.full_name %></td>
            <td>
              <%= button_to "Approve", approve_team_attendance_edit_approval_path(record), method: :patch, class: "btn btn-primary" %>
              <%= button_to "Reject", reject_team_attendance_edit_approval_path(record), method: :patch, class: "btn btn-danger-outline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>You're all caught up.</p>
  <% end %>
</div>

<% if @decided.any? %>
  <div class="card">
    <h2>Recently decided</h2>
    <table>
      <thead><tr><th>Employee</th><th>Date</th><th>Status</th></tr></thead>
      <tbody>
        <% @decided.each do |record| %>
          <tr>
            <td><%= record.employee.full_name %></td>
            <td><%= record.date %></td>
            <td><% badge = BadgePresenter.new(record.edit_approval_status) %><span class="<%= badge.css_class %>"><%= badge.label %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
