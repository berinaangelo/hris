<% content_for :title, "Approvals" %>

<div class="team-approvals-page">
  <div class="greet-block">
    <h2>Approvals</h2>
    <p><%= pluralize(@pending.size, "request") %> waiting on you</p>
  </div>

  <div class="card">
    <% if @pending.any? %>
      <div class="queue-live">
        <% @pending.each do |request| %>
          <% balance = request.employee.leave_balances.find_by(leave_type: request.leave_type, year: request.start_date.year) %>
          <% remaining = balance&.remaining_days %>
          <% low = remaining && remaining - request.days_requested < 2 %>
          <div class="req-item">
            <span class="avatar"><%= request.employee.first_name.first %><%= request.employee.last_name.first %></span>
            <div class="who">
              <h4><%= request.employee.full_name %></h4>
              <p><%= request.employee.job_title %></p>
            </div>
            <div class="mid">
              <p class="line1">
                <span class="type"><%= request.leave_type.name %></span> ·
                <%= request.start_date == request.end_date ? request.start_date.to_fs(:long) : "#{request.start_date.strftime('%b %-d')}–#{request.end_date.strftime('%b %-d, %Y')}" %> ·
                <%= pluralize(request.days_requested, "day") %>
              </p>
              <span class="balance-chip<%= " low" if low %>">
                <%= lucide_icon(:calendar) %>
                <% if remaining %>
                  Balance <b><%= number_with_precision(remaining, precision: 1) %></b> of <%= number_with_precision(balance.entitled_days, precision: 1) %> days
                  <% if low %> — would leave <b><%= number_with_precision(remaining - request.days_requested, precision: 1) %></b><% end %>
                <% else %>
                  No balance on file
                <% end %>
              </span>
            </div>
            <div class="actions">
              <%= button_to approve_team_approval_path(request), method: :patch, class: "btn-primary" do %>
                <%= lucide_icon(:"circle-check") %>Approve
              <% end %>
              <span data-controller="modal">
                <button type="button" class="btn-danger-ghost" data-action="modal#open">
                  <%= lucide_icon(:x) %>Reject
                </button>
                <%= render "shared/drawer", title: "Reject #{request.employee.full_name}'s request" do %>
                  <p class="tt-drawer-note">
                    <%= request.leave_type.name %> ·
                    <%= request.start_date == request.end_date ? request.start_date.to_fs(:long) : "#{request.start_date.strftime('%b %-d')}–#{request.end_date.strftime('%b %-d, %Y')}" %>
                    · <%= pluralize(request.days_requested, "day") %>. This can't be undone from here.
                  </p>
                  <%= form_with url: reject_team_approval_path(request), method: :patch, local: true do %>
                    <div class="tt-drawer-field">
                      <label for="reject-note-<%= request.id %>">Reason (optional)</label>
                      <textarea class="plain-input" id="reject-note-<%= request.id %>" name="decision_note" rows="3" placeholder="Let them know why, if useful"></textarea>
                    </div>
                    <div class="tt-drawer-foot">
                      <button type="submit" class="btn-danger-ghost">Reject request</button>
                      <button type="button" class="btn-ghost" data-action="modal#close">Cancel</button>
                    </div>
                  <% end %>
                <% end %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <%= lucide_icon(:"circle-check", stroke_width: 1.75) %>
        <h3>You're all caught up</h3>
        <p>No pending requests right now.</p>
      </div>
    <% end %>
  </div>

  <% if @decided.any? %>
    <div class="card">
      <div class="list-head"><h3>Recently decided</h3></div>
      <div class="table-wrap">
        <table class="dectable">
          <thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Status</th><th>Note</th></tr></thead>
          <tbody>
            <% @decided.each do |request| %>
              <tr>
                <td><%= request.employee.full_name %></td>
                <td><%= request.leave_type.name %></td>
                <td class="mono"><%= request.start_date %> – <%= request.end_date %></td>
                <td><% badge = BadgePresenter.new(request.status) %><span class="<%= badge.css_class %>"><%= badge.label %></span></td>
                <td><%= request.decision_note.presence || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
