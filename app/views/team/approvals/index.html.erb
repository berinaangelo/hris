<h1>Approvals</h1>

<div class="card">
  <% if @pending.any? %>
    <table>
      <thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Days</th><th>Balance</th><th></th></tr></thead>
      <tbody>
        <% @pending.each do |request| %>
          <tr>
            <td><%= request.employee.full_name %></td>
            <td><%= request.leave_type.name %></td>
            <td><%= request.start_date %> – <%= request.end_date %></td>
            <td><%= request.days_requested %></td>
            <td>
              <% balance = request.employee.leave_balances.find_by(leave_type: request.leave_type, year: request.start_date.year) %>
              <%= balance ? number_with_precision(balance.remaining_days, precision: 1) : "—" %>
            </td>
            <td>
              <%= button_to "Approve", approve_team_approval_path(request), method: :patch, class: "btn btn-primary" %>
              <%= form_with url: reject_team_approval_path(request), method: :patch, local: true do %>
                <input type="text" name="decision_note" placeholder="Reason (optional)">
                <button type="submit" class="btn btn-danger-outline">Reject</button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>You're all caught up.</p>
  <% end %>
</div>

<% if @decided.any? %>
  <div class="card">
    <h2>Recently decided</h2>
    <table>
      <thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Status</th><th>Note</th></tr></thead>
      <tbody>
        <% @decided.each do |request| %>
          <tr>
            <td><%= request.employee.full_name %></td>
            <td><%= request.leave_type.name %></td>
            <td><%= request.start_date %> – <%= request.end_date %></td>
            <td><% badge = BadgePresenter.new(request.status) %><span class="<%= badge.css_class %>"><%= badge.label %></span></td>
            <td><%= request.decision_note.presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
