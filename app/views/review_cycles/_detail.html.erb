<div class="card review-cycle-detail">
  <% if cycle.nil? %>
    <p>Select a cycle to see its details.</p>
  <% else %>
    <h2><%= cycle.start_date %> – <%= cycle.end_date %> (<%= cycle.pip? ? "PIP" : "Regular" %>)</h2>

    <% if cycle.published? %>
      <% if cycle.overall_rating %>
        <p>Overall rating: <strong><%= cycle.overall_rating.round(1) %>/5</strong></p>
      <% end %>
      <% if cycle.pip? && cycle.outcome %>
        <% badge = BadgePresenter.new(cycle.outcome) %>
        <p>Outcome: <span class="<%= badge.css_class %>"><%= badge.label %></span></p>
      <% end %>
      <%= render "review_cycles/kpi_table", kpi_entries: cycle.kpi_entries %>
      <% if cycle.manager_comment.present? %>
        <p><strong>Manager's comment:</strong> <%= cycle.manager_comment %></p>
      <% end %>
    <% else %>
      <% badge = BadgePresenter.new(cycle.status) %>
      <p><span class="<%= badge.css_class %>"><%= badge.label %></span></p>
      <p>Your manager is still working on this cycle.</p>
      <h3>KPIs for this cycle</h3>
      <%= render "review_cycles/kpi_table", kpi_entries: cycle.kpi_entries, scores_hidden: true %>
    <% end %>
  <% end %>
</div>
