<div class="op2-detail-panel">
  <% if cycle.nil? %>
    <p>No review cycles yet.</p>
  <% elsif !cycle.published? %>
    <div class="inprogress-note">
      <%= lucide_icon(:clock, stroke_width: 1.75) %>
      Your manager is completing this cycle — you'll be notified when it's published. Runs through <%= cycle.end_date.strftime("%b %-d, %Y") %>.
    </div>
    <h3 class="kpi-preview-head">KPIs for this cycle</h3>
    <%= render "review_cycles/kpi_table", kpi_entries: cycle.kpi_entries, scores_hidden: true %>
  <% else %>
    <div class="rating-hero">
      <div>
        <p class="card-label" style="color:#A9B4CB;"><%= cycle.start_date.strftime("%b %Y") %>–<%= cycle.end_date.strftime("%b %Y") %> · Overall rating</p>
        <p class="num"><%= cycle.overall_rating ? cycle.overall_rating.round(1) : "—" %> <span class="denom">/ 5</span></p>
      </div>
      <% if cycle.employee.manager %>
        <span class="reviewer">Reviewed by <%= cycle.employee.manager.full_name %></span>
      <% end %>
    </div>

    <% if cycle.pip? && cycle.outcome %>
      <% badge = BadgePresenter.new(cycle.outcome) %>
      <p><span class="<%= badge.css_class %>"><%= badge.label %></span></p>
    <% end %>

    <%= render "review_cycles/kpi_table", kpi_entries: cycle.kpi_entries, compact: true %>

    <% if cycle.manager_comment.present? %>
      <div class="manager-comment"><b><%= cycle.employee.manager&.first_name || "Manager" %>:</b> <%= cycle.manager_comment %></div>
    <% end %>
  <% end %>
</div>
