<% status = EmployeeStatusPresenter.new(current_employee.status) %>

<div class="summary-modal-page" data-controller="modal" data-modal-open-value="<%= @open_profile_modal ? "true" : "false" %>">
  <div class="mock-cols">
    <div class="summary-col">
      <div>
        <span class="avatar-lg"><%= current_employee.first_name.first %><%= current_employee.last_name.first %></span>
        <h2><%= current_employee.full_name %></h2>
        <p><%= current_employee.job_title %> · <%= current_employee.department %></p>
        <span class="<%= status.css_class %>" style="margin-top:0.5rem;"><%= status.label %></span>

        <div class="summary-facts">
          <div class="row"><span>Employee ID</span><span><%= current_employee.employee_number %></span></div>
          <div class="row"><span>Manager</span><span class="email"><%= current_employee.manager&.full_name || "—" %></span></div>
          <div class="row"><span>Start date</span><span><%= current_employee.start_date %></span></div>
          <div class="row"><span>Mobile</span><span><%= current_employee.mobile_number.presence || "—" %></span></div>
          <div class="row"><span>Email</span><span class="email"><%= current_employee.personal_email.presence || "—" %></span></div>
        </div>
      </div>

      <button type="button" class="btn btn-primary summary-cta" data-action="modal#open">
        <%= lucide_icon(:pencil, stroke_width: 2) %>
        Edit personal info
      </button>
    </div>
  

    <div>
      <div class="section">
        <div class="section-head"><h3>Onboarding checklist</h3></div>
        <% @onboarding_items.each do |item| %>
          <div class="checklist-row">
            <% if item.completed? %>
              <%= lucide_icon(:"circle-check", class: "check", stroke_width: 2) %>
            <% else %>
              <span style="width:18px;flex:0 0 auto;"></span>
            <% end %>
            <span class="txt"><%= item.item_key.humanize %></span>
            <span class="<%= item.completed? ? "badge badge-positive" : "badge badge-caution" %>"><%= item.completed? ? "Done" : "Pending" %></span>
          </div>
        <% end %>
      </div>

      <div class="section">
        <div class="section-head"><h3>Documents</h3></div>
        <% if @documents.any? %>
          <% @documents.each do |document| %>
            <div class="doc-row">
              <%= lucide_icon(:file, class: "file") %>
              <div class="txt">
                <p class="name"><%= document.title %></p>
                <p class="meta">Uploaded <%= document.created_at.to_date %></p>
              </div>
              <div class="actions">
                <%= link_to url_for(document.file), class: "icon-btn", title: "Download" do %>
                  <%= lucide_icon(:download) %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p style="color:var(--neutral);font-size:0.875rem;">No documents on file.</p>
        <% end %>
      </div>
    </div>
  </div>

  <dialog class="app-modal modal-sm" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop">
    <div class="app-modal-content">
      <div class="modal-box-head">
        <h3>Edit personal info</h3>
        <button type="button" class="modal-close" data-action="modal#close" aria-label="Close">
          <%= lucide_icon(:x, stroke_width: 2) %>
        </button>
      </div>
      <%= render "my_profile/form" %>
    </div>
  </dialog>
</div>
