<% content_for :title, "Home" %>

<div class="dashboard-page">
  <div class="greet-block">
    <h2><%= time_of_day_greeting(current_employee) %></h2>
    <p>You report to <%= current_employee.manager&.full_name || "no one — top of the org" %> · <%= current_employee.department %></p>
  </div>

  <div class="hero">
    <div>
      <p class="card-label" style="color:#A9B4CB;">Leave balance</p>
      <% if @leave_balance %>
        <p class="hero-num"><%= number_with_precision(@leave_balance.remaining_days, precision: 1) %> <span class="hero-num-unit">days remaining</span></p>
        <% used_ratio = @leave_balance.entitled_days.zero? ? 0 : (@leave_balance.used_days / @leave_balance.entitled_days * 100).round(1) %>
        <div class="meter-track"><div class="meter-fill" style="width: <%= used_ratio %>%"></div></div>
        <p class="hero-sub"><%= number_with_precision(@leave_balance.used_days, precision: 1) %> of <%= number_with_precision(@leave_balance.entitled_days, precision: 1) %> used this year</p>
      <% else %>
        <p class="hero-num">No leave balance on file yet</p>
      <% end %>
    </div>
    <div class="hero-right">
      <%= link_to leave_requests_path, class: "btn btn-primary" do %>
        Request time off
        <%= lucide_icon(:"arrow-right", stroke_width: 2) %>
      <% end %>
    </div>
  </div>

  <div class="mock2-cols">
    <div>
      <div class="req-list-head">
        <h3>My requests</h3>
      </div>
      <% if @leave_requests.any? %>
        <% @leave_requests.each do |request| %>
          <% badge = BadgePresenter.new(request.status) %>
          <div class="req-row">
            <span class="dates"><%= request.start_date == request.end_date ? request.start_date.strftime("%b %-d") : "#{request.start_date.strftime("%b %-d")}–#{request.end_date.strftime("%-d")}" %></span>
            <span class="type"><%= request.leave_type.name %></span>
            <span class="<%= badge.css_class %>"><%= badge.label %></span>
          </div>
        <% end %>
      <% else %>
        <p class="muted">No requests yet.</p>
      <% end %>
    </div>

    <div class="aside-stack">
      <div class="card">
        <p class="card-label">At a glance</p>
        <p class="glance-line">
          <%= pluralize(@pending_my_requests_count, "request") %>
          <% if @pending_my_requests_count > 0 %><span class="count-pill">pending</span><% end %>
        </p>
        <p class="glance-sub"><%= @ytd_approved_count %> approved, <%= @ytd_rejected_count %> rejected this year</p>
      </div>

      <div class="card">
        <p class="card-label"><%= lucide_icon(:clock, stroke_width: 1.75) %> Attendance</p>
        <% if @todays_attendance_record&.clock_out_at.present? %>
          <p class="glance-sub">Clocked out at <%= @todays_attendance_record.clock_out_at.in_time_zone(current_employee.company.timezone).strftime("%l:%M %p") %>. See you tomorrow.</p>
        <% elsif @todays_attendance_record&.clock_in_at.present? %>
          <p class="glance-sub">Clocked in at <%= @todays_attendance_record.clock_in_at.in_time_zone(current_employee.company.timezone).strftime("%l:%M %p") %>.</p>
          <div class="attendance-actions">
            <%= button_to "Clock out", clock_out_attendance_path, method: :patch, class: "btn btn-ghost" %>
          </div>
        <% else %>
          <p class="glance-sub">Not clocked in yet today.</p>
          <div class="attendance-actions">
            <%= button_to "Clock in", clock_in_attendance_path, method: :post, class: "btn btn-ghost" %>
          </div>
        <% end %>
      </div>

      <% if current_employee.manager? || current_employee.admin? %>
        <% if @pending_approvals_count > 0 %>
          <div class="manager-card">
            <%= lucide_icon(:"circle-check", stroke_width: 1.75) %>
            <div class="txt"><b><%= pluralize(@pending_approvals_count, "request") %></b> awaiting your approval as manager. <%= link_to "Review now", team_approvals_path %></div>
          </div>
        <% end %>

        <% if @pending_correction_requests_count > 0 %>
          <div class="manager-card">
            <%= lucide_icon(:"circle-check", stroke_width: 1.75) %>
            <div class="txt"><b><%= pluralize(@pending_correction_requests_count, "attendance correction") %></b> waiting on you. <%= link_to "Review now", team_attendance_correction_requests_path %></div>
          </div>
        <% end %>

        <div class="manager-card">
          <%= lucide_icon(:"circle-check", stroke_width: 1.75) %>
          <div class="txt"><%= link_to "Team attendance", team_attendance_records_path %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
