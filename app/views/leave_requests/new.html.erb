<h1>Request time off</h1>

<div class="card">
  <%= form_with url: leave_requests_path, scope: :leave_request do |f| %>
    <div class="field">
      <%= f.label :leave_type_id, "Leave type" %>
      <%= f.select :leave_type_id, @leave_types.map { |t| [t.name, t.id] } %>
    </div>
    <div class="field">
      <%= f.label :start_date %>
      <%= f.date_field :start_date, required: true %>
    </div>
    <div class="field">
      <%= f.label :end_date %>
      <%= f.date_field :end_date, required: true %>
    </div>
    <div class="field">
      <%= f.label :days_requested %>
      <%= f.number_field :days_requested, step: 0.5, min: 0.5, required: true %>
    </div>
    <div class="field">
      <%= f.label :reason, "Reason (optional)" %>
      <%= f.text_area :reason %>
    </div>
    <p>Goes to <%= current_employee.manager&.full_name || "an admin" %> for approval.</p>
    <%= f.submit "Submit request", class: "btn btn-primary" %>
  <% end %>
</div>
