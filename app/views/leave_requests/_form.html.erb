<%= form_with model: @leave_request, url: leave_requests_path, scope: :leave_request,
              html: { class: "reqform", data: { controller: "leave-request-days" } } do |f| %>
  <div class="field-edit">
    <%= f.label :leave_type_id, "Leave type" %>
    <%= f.select :leave_type_id, @leave_types.map { |t| [ t.name, t.id ] }, {}, class: "plain-select" %>
  </div>

  <div class="row2">
    <div class="field-edit">
      <%= f.label :start_date, "Start date" %>
      <%= f.date_field :start_date, required: true, class: "plain-input",
            data: { leave_request_days_target: "start", action: "change->leave-request-days#recompute" } %>
    </div>
    <div class="field-edit">
      <%= f.label :end_date, "End date" %>
      <%= f.date_field :end_date, required: true, class: "plain-input#{" has-error" if @leave_request.errors[:end_date].any?}",
            data: { leave_request_days_target: "end", action: "change->leave-request-days#recompute" } %>
      <% if @leave_request.errors[:end_date].any? %>
        <p class="field-error"><%= @leave_request.errors[:end_date].first %></p>
      <% end %>
    </div>
  </div>

  <%= f.hidden_field :days_requested, data: { leave_request_days_target: "days" } %>

  <div class="balance-inline">
    <%= lucide_icon(:calendar, stroke_width: 1.75) %>
    <span>
      <% if @leave_balance %>
        <b><%= number_with_precision(@leave_balance.remaining_days, precision: 1) %></b> days remaining ·
      <% end %>
      this request uses <b data-leave-request-days-target="usesCount"><%= @leave_request.days_requested.presence || 0 %></b>
    </span>
  </div>

  <% if @leave_request.errors[:start_date].any? %>
    <p class="field-error"><%= @leave_request.errors[:start_date].first.capitalize %></p>
  <% end %>

  <div class="field-edit">
    <%= f.label :reason, "Reason (optional)" %>
    <%= f.text_area :reason, class: "plain-textarea" %>
  </div>

  <div class="approver-note">
    <%= lucide_icon(:user, stroke_width: 1.75) %>
    Goes to <b><%= current_employee.manager&.full_name || "an admin" %></b> for approval
  </div>

  <div class="save-bar">
    <button type="button" class="btn btn-ghost" data-action="modal#close">Cancel</button>
    <%= f.submit "Submit request", class: "btn btn-primary" %>
  </div>
<% end %>
