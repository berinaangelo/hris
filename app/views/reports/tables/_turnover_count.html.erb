<table class="cptable">
  <thead>
    <tr><th>Department</th><th class="num-col">Departures</th></tr>
  </thead>
  <tbody>
    <% rows.each do |row| %>
      <tr>
        <td><%= row[:department] %></td>
        <td class="num-col mono"><%= row[:departures] %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr><td>Total</td><td class="num-col mono"><%= rows.sum { |row| row[:departures] } %></td></tr>
  </tfoot>
</table>
